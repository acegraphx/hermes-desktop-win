<UserControl x:Class="HermesDesktop.Views.SessionBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" MinWidth="250"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: session list -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Sessions" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBox DockPanel.Dock="Top" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                     Padding="8,6" FontSize="13" Margin="0,0,0,8">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Tag" Value="Search sessions..."/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <TextBlock DockPanel.Dock="Top" FontSize="12" Foreground="{DynamicResource TextTertiary}" Margin="0,0,0,8">
                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                <Run Text=" sessions"/>
            </TextBlock>

            <TextBlock DockPanel.Dock="Top" Text="Loading..." Foreground="{DynamicResource TextTertiary}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

            <ListView ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <DockPanel>
                                <TextBlock Text="Pinned" DockPanel.Dock="Right" FontSize="10"
                                           Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0"
                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{Binding DisplayTitle}" FontSize="13" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                            </DockPanel>
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock Text="{Binding Model}" FontSize="11" Foreground="{DynamicResource TextTertiary}" DockPanel.Dock="Left"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiary}" HorizontalAlignment="Right">
                                    <Run Text="{Binding MessageCount, Mode=OneWay}"/>
                                    <Run Text=" msgs"/>
                                </TextBlock>
                            </DockPanel>
                            <TextBlock Text="{Binding LastActive, Converter={StaticResource RelativeDate}}"
                                       FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="{DynamicResource SplitterBrush}" Margin="8,0"/>

        <!-- Right: session detail -->
        <DockPanel Grid.Column="2">
            <!-- No selection -->
            <TextBlock Text="Select a session to view its transcript"
                       FontSize="14" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock.Visibility>
                    <Binding Path="ShowNoTranscriptSelection" Converter="{StaticResource BoolToVisibility}"/>
                </TextBlock.Visibility>
            </TextBlock>

            <!-- Detail header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Transcript" Padding="12,4" Margin="0,0,6,0"
                            Command="{Binding ShowTranscriptCommand}"/>
                    <Button Content="Chat" Padding="12,4" Margin="0,0,6,0"
                            Command="{Binding ShowChatCommand}"/>
                    <Button Content="{Binding PinButtonText}" Padding="12,4" Margin="0,0,6,0"
                            Command="{Binding TogglePinCommand}"
                            Visibility="{Binding SelectedSession, Converter={StaticResource NullToVisibility}}"/>
                    <Button Content="New Chat" Padding="12,4" Margin="0,0,6,0"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding StartNewChatCommand}"/>
                    <Button Content="Resume in Chat" Padding="12,4" Margin="0,0,6,0"
                            Command="{Binding ResumeInChatCommand}"
                            Visibility="{Binding SelectedSession, Converter={StaticResource NullToVisibility}}"/>
                    <Button Content="Resume in Terminal" Padding="12,4" Margin="0,0,6,0"
                            Command="{Binding ResumeInTerminalCommand}"
                            Visibility="{Binding SelectedSession, Converter={StaticResource NullToVisibility}}"/>
                    <Button Content="Delete" Padding="12,4"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding RequestDeleteSessionCommand}" CommandParameter="{Binding SelectedSession}"
                            Visibility="{Binding SelectedSession, Converter={StaticResource NullToVisibility}}"/>
                </StackPanel>
                <TextBlock Text="{Binding SelectedSession.DisplayTitle, TargetNullValue='New Chat'}" FontSize="18" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBackground}" CornerRadius="6"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="10" Margin="0,10,0,0"
                    Visibility="{Binding IsTranscriptMode, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBox Text="{Binding ChatPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="58" Padding="8,6"
                             ToolTip="Message Hermes"/>
                    <DockPanel Margin="0,8,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="New Chat" Padding="12,5" Margin="0,0,6,0"
                                    Command="{Binding StartNewChatCommand}"/>
                            <Button Content="Send" Padding="12,5" Style="{StaticResource AccentButton}"
                                    Command="{Binding SendChatCommand}"/>
                        </StackPanel>
                        <CheckBox Content="Auto-approve commands" IsChecked="{Binding AutoApproveCommands}"
                                  Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding PendingTurn.Prompt}" FontSize="12"
                               Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding PendingTurn, Converter={StaticResource NullToVisibility}}"/>
                    <TextBlock Text="{Binding ChatError}" FontSize="12" Foreground="#E46362"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding ChatError, Converter={StaticResource NullToVisibility}}"/>
                </StackPanel>
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="Loading transcript..." Foreground="{DynamicResource TextTertiary}"
                       Visibility="{Binding IsLoadingDetail, Converter={StaticResource BoolToVisibility}}"/>

            <ContentControl Content="{Binding ChatTerminalViewModel}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Visibility="{Binding IsChatMode, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Transcript messages -->
            <ListView ItemsSource="{Binding TranscriptMessages}"
                      BorderThickness="0" Margin="0,4,0,0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsTranscriptMode, Converter={StaticResource BoolToVisibility}}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" Margin="0,2" CornerRadius="6"
                                Background="{Binding Role, Converter={StaticResource RoleToBrush}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Timestamp, Converter={StaticResource RelativeDate}}"
                                               FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBox Text="{Binding Content, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                                         MaxHeight="300" Foreground="{DynamicResource TextPrimary}"
                                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Padding="0" IsTabStop="False" Cursor="IBeam"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>

        <!-- Delete confirmation overlay -->
        <Border Grid.ColumnSpan="3" Background="{DynamicResource OverlayBackground}" Panel.ZIndex="100"
                Visibility="{Binding ShowDeleteConfirmation, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource DialogBackground}" CornerRadius="8" Padding="24" MaxWidth="400"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Delete this session?" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="This will permanently remove the session and all its messages from the remote host."
                               FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelDeleteSessionCommand}"
                                Padding="16,6" Margin="0,0,8,0"/>
                        <Button Content="Delete" Command="{Binding ConfirmDeleteSessionCommand}"
                                Padding="16,6" Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
