<UserControl x:Class="HermesDesktop.Views.KanbanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="360" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Dispatch" Padding="12,5" Margin="0,0,6,0"
                            Command="{Binding DispatchNowCommand}"/>
                    <Button Content="New Task" Padding="12,5" Margin="0,0,6,0"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding NewTaskCommand}"/>
                    <Button Content="New Board" Padding="12,5" Margin="0,0,6,0"
                            Command="{Binding NewBoardCommand}"/>
                    <Button Content="Refresh" Padding="12,5"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <TextBlock Text="Kanban" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
            </DockPanel>

            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}"
                          DisplayMemberPath="ResolvedName" Padding="8,5"/>
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         Padding="8,5" Margin="8,0" ToolTip="Search tasks"/>
                <CheckBox Grid.Column="2" Content="Archived" IsChecked="{Binding IncludeArchived}"
                          VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
            </Grid>

            <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="#E46362"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextTertiary}"
                       TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock DockPanel.Dock="Top" Text="Loading Kanban board..." Foreground="{DynamicResource TextTertiary}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="280" Margin="0,0,12,0" Background="{DynamicResource PanelBackground}"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="6">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="10,8">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="12"
                                                   Foreground="{DynamicResource TextTertiary}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                    </DockPanel>
                                    <ListBox ItemsSource="{Binding Tasks}"
                                             SelectedItem="{Binding DataContext.SelectedTask, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                             BorderThickness="0" Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10" Margin="4,3" CornerRadius="5"
                                                        Background="{DynamicResource CardBackground}"
                                                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ResolvedTitle}" FontSize="13" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Id}" FontSize="10" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                                        <WrapPanel Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding PriorityLabel}" FontSize="11"
                                                                       Foreground="{DynamicResource TextTertiary}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Assignee, TargetNullValue='Unassigned'}" FontSize="11"
                                                                       Foreground="{DynamicResource TextTertiary}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding LatestActivityDate, Converter={StaticResource RelativeDate}}"
                                                                       FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="{DynamicResource SplitterBrush}" Margin="8,0"/>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Visibility="{Binding HasSelectedTask, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SelectedTask.ResolvedTitle}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding SelectedTask.Id}" FontSize="11" FontFamily="Consolas"
                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>

                <WrapPanel Margin="0,0,0,12">
                    <Button Content="Block" Padding="10,4" Margin="0,0,6,6" Command="{Binding BlockCommand}"/>
                    <Button Content="Unblock" Padding="10,4" Margin="0,0,6,6" Command="{Binding UnblockCommand}"/>
                    <Button Content="Complete" Padding="10,4" Margin="0,0,6,6" Command="{Binding CompleteCommand}"/>
                    <Button Content="Reclaim" Padding="10,4" Margin="0,0,6,6" Command="{Binding ReclaimCommand}"/>
                    <Button Content="Archive" Padding="10,4" Margin="0,0,6,6" Command="{Binding ArchiveTaskCommand}"/>
                    <Button Content="Delete" Padding="10,4" Margin="0,0,6,6" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteTaskCommand}"/>
                </WrapPanel>

                <TextBlock Text="Body" FontSize="11" Foreground="{DynamicResource TextTertiary}"/>
                <TextBox Text="{Binding EditBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="80" Padding="8,6" Margin="0,4,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding EditTenant, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                             ToolTip="Tenant"/>
                    <TextBox Grid.Column="1" Text="{Binding EditPriority, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="8,0,0,0" ToolTip="Priority"/>
                </Grid>
                <TextBox Text="{Binding EditSkills, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                         Margin="0,0,0,8" ToolTip="Skills, comma-separated"/>
                <Button Content="Save Fields" Padding="12,5" HorizontalAlignment="Left"
                        Command="{Binding SaveFieldsCommand}" Margin="0,0,0,12"/>

                <TextBlock Text="Dependencies" FontSize="11" Foreground="{DynamicResource TextTertiary}"/>
                <TextBox Text="{Binding EditParents, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                         Margin="0,4,0,6" ToolTip="Parent task IDs"/>
                <TextBox Text="{Binding EditChildren, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                         Margin="0,0,0,8" ToolTip="Child task IDs"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Save Parents" Padding="10,4" Margin="0,0,6,0" Command="{Binding SaveParentsCommand}"/>
                    <Button Content="Save Children" Padding="10,4" Command="{Binding SaveChildrenCommand}"/>
                </StackPanel>

                <TextBlock Text="Comment" FontSize="11" Foreground="{DynamicResource TextTertiary}"/>
                <TextBox Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="54" Padding="8,6" Margin="0,4,0,8"/>
                <Button Content="Add Comment" Padding="12,5" HorizontalAlignment="Left"
                        Command="{Binding AddCommentCommand}" Margin="0,0,0,12"/>

                <TextBlock Text="Assignment and recovery" FontSize="11" Foreground="{DynamicResource TextTertiary}"/>
                <TextBox Text="{Binding AssignAssignee, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                         Margin="0,4,0,6" ToolTip="Assignee"/>
                <TextBox Text="{Binding BlockReason, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                         Margin="0,0,0,6" ToolTip="Block reason"/>
                <TextBox Text="{Binding RecoveryReason, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                         Margin="0,0,0,6" ToolTip="Recovery reason"/>
                <CheckBox Content="Reclaim before reassign" IsChecked="{Binding ReclaimBeforeReassign}"
                          Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Assign" Padding="10,4" Margin="0,0,6,0" Command="{Binding AssignCommand}"/>
                    <Button Content="Reassign" Padding="10,4" Command="{Binding ReassignCommand}"/>
                </StackPanel>

                <TextBlock Text="Result" FontSize="11" Foreground="{DynamicResource TextTertiary}"/>
                <TextBox Text="{Binding CompleteResult, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="64" Padding="8,6" Margin="0,4,0,6"/>
                <TextBox Text="{Binding RecoverySummary, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                         Margin="0,0,0,6" ToolTip="Recovery summary"/>
                <TextBox Text="{Binding RecoveryMetadataJson, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                         Margin="0,0,0,8" ToolTip="Recovery metadata JSON"/>
                <Button Content="Edit Result" Padding="12,5" HorizontalAlignment="Left"
                        Command="{Binding EditResultCommand}" Margin="0,0,0,12"/>

                <TextBlock Text="Loading detail..." Foreground="{DynamicResource TextTertiary}"
                           Visibility="{Binding IsLoadingDetail, Converter={StaticResource BoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding SelectedDetail.Comments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8" Margin="0,0,0,6" CornerRadius="4"
                                    Background="{DynamicResource PanelBackground}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Author}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Body}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.ColumnSpan="3" Background="{DynamicResource OverlayBackground}" Panel.ZIndex="100"
                Visibility="{Binding ShowTaskDialog, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource DialogBackground}" CornerRadius="8" Padding="24" Width="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="New Kanban Task" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                             Margin="0,0,0,8" ToolTip="Title"/>
                    <TextBox Text="{Binding TaskBody, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Margin="0,0,0,8" ToolTip="Body"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TaskAssignee, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="Assignee"/>
                        <TextBox Grid.Column="1" Text="{Binding TaskPriority, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="8,0,0,0" ToolTip="Priority"/>
                    </Grid>
                    <TextBox Text="{Binding TaskTenant, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,8" ToolTip="Tenant"/>
                    <TextBox Text="{Binding TaskSkills, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,8" ToolTip="Skills"/>
                    <TextBox Text="{Binding TaskParents, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,8" ToolTip="Parent IDs"/>
                    <CheckBox Content="Start in triage" IsChecked="{Binding TaskStartsInTriage}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding DialogError}" Foreground="#E46362" TextWrapping="Wrap"
                               Visibility="{Binding DialogError, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Padding="16,6" Margin="0,0,8,0" Command="{Binding CancelTaskDialogCommand}"/>
                        <Button Content="Create" Padding="16,6" Style="{StaticResource AccentButton}" Command="{Binding SaveNewTaskCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="3" Background="{DynamicResource OverlayBackground}" Panel.ZIndex="101"
                Visibility="{Binding ShowBoardDialog, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource DialogBackground}" CornerRadius="8" Padding="24" Width="460"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="New Kanban Board" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding BoardSlug, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,8" ToolTip="Slug"/>
                    <TextBox Text="{Binding BoardName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,8" ToolTip="Name"/>
                    <TextBox Text="{Binding BoardDescription, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,8" ToolTip="Description"/>
                    <TextBox Text="{Binding BoardIcon, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,8" ToolTip="Icon"/>
                    <TextBox Text="{Binding BoardColor, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,8" ToolTip="Color"/>
                    <CheckBox Content="Switch after create" IsChecked="{Binding BoardSwitchAfterCreate}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding DialogError}" Foreground="#E46362" TextWrapping="Wrap"
                               Visibility="{Binding DialogError, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Padding="16,6" Margin="0,0,8,0" Command="{Binding CancelBoardDialogCommand}"/>
                        <Button Content="Create" Padding="16,6" Style="{StaticResource AccentButton}" Command="{Binding SaveNewBoardCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
