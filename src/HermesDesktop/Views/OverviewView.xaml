<UserControl x:Class="HermesDesktop.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <!-- Loading -->
        <TextBlock Text="Loading overview..." FontSize="14" Foreground="{DynamicResource TextTertiary}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <!-- Error -->
        <TextBlock Text="{Binding ErrorMessage}" FontSize="14" Foreground="{DynamicResource ErrorText}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"
                   TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <!-- Content -->
        <ScrollViewer Visibility="{Binding Overview, Converter={StaticResource NullToVisibility}}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600">
                <TextBlock Text="Overview" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

                <TextBlock Text="Remote Home" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                <TextBlock Text="{Binding Overview.Home}" FontSize="14"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,12"/>

                <TextBlock Text="Hermes Root" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                <TextBlock Text="{Binding Overview.HermesRoot}" FontSize="14"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,12"/>

                <TextBlock Text="Python Version" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                <TextBlock Text="{Binding Overview.PythonVersion}" FontSize="14"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,12"/>

                <TextBlock Text="Session Source" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                <TextBlock Text="{Binding Overview.SessionSource}" FontSize="14"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,12"/>

                <TextBlock Text="Session Store" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                <TextBlock Text="{Binding Overview.SessionStore}" FontSize="14"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,12"/>

                <Border Background="{DynamicResource CardBackground}" CornerRadius="6"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                        Padding="12" Margin="0,4,0,16">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChatReadinessBadge}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0"/>
                            <TextBlock Text="Chat" FontSize="16" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding ChatReadinessTitle}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,2"/>
                        <TextBlock Text="{Binding ChatReadinessDetail}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        <TextBlock Text="Transport" FontSize="12" Foreground="{DynamicResource TextTertiary}" Margin="0,10,0,0"/>
                        <TextBlock Text="Hermes TUI over SSH" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Hermes CLI" FontSize="12" Foreground="{DynamicResource TextTertiary}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Overview.HermesCliPath, TargetNullValue='Not found'}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Active Hermes Profile" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                           Visibility="{Binding Overview.ProfileName, Converter={StaticResource NullToVisibility}}"/>
                <TextBlock Text="{Binding Overview.ProfileName}" FontSize="14"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,12"
                           Visibility="{Binding Overview.ProfileName, Converter={StaticResource NullToVisibility}}"/>

                <TextBlock Text="Available Profiles" FontSize="16" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,8"
                           Visibility="{Binding HasMultipleProfiles, Converter={StaticResource BoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Overview.AvailableProfiles}" Margin="0,0,0,20"
                              Visibility="{Binding HasMultipleProfiles, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackground}" CornerRadius="4"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                    Padding="10,6" Margin="0,0,0,4">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Switch" FontSize="11" Padding="8,2"
                                            Command="{Binding DataContext.SwitchProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Name}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Path}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Tracked Files" FontSize="16" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Overview.TrackedFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                           Text="{Binding Size, StringFormat='{}{0:N0} bytes'}"
                                           Visibility="{Binding Exists, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextPrimary}">
                                    <Run Text="{Binding Path, Mode=OneWay}"/>
                                    <Run Text=" " />
                                    <Run Text="{Binding Exists, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource TextTertiary}"/>
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="Refresh" Command="{Binding LoadOverviewCommand}" Margin="0,20,0,0"
                        Padding="16,6" HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
