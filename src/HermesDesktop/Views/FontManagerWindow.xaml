<Window x:Class="HermesDesktop.Views.FontManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HermesDesktop.ViewModels"
        Title="Manage Fonts"
        Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="4"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:FontManagerViewModel/>
    </Window.DataContext>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Background="{DynamicResource WindowBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <Image Source="/Resources/Icons/hermes.ico" Width="16" Height="16"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiary}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE921;" Click="MinimizeButton_Click"
                        ToolTip="Minimize"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE922;" Click="MaximizeButton_Click"
                        ToolTip="Maximize"/>
                <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}"
                        Content="&#xE8BB;" Click="CloseButton_Click"
                        ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <DockPanel Grid.Row="1" Margin="16,8,16,16">
            <TextBlock DockPanel.Dock="Top" Text="Fonts"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top"
                       Text="Bundled fonts ship with Hermes. Catalog fonts download on demand and persist under %APPDATA%\HermesDesktop\fonts."
                       TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextTertiary}"
                       Margin="0,0,0,12"/>

            <Button DockPanel.Dock="Bottom" Content="Close"
                    HorizontalAlignment="Right" Padding="20,6"
                    Margin="0,12,0,0" IsCancel="True"
                    Foreground="{DynamicResource TextPrimary}"
                    Background="Transparent"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FontManagerItemViewModel}">
                            <Border Padding="12" Margin="0,0,0,8" CornerRadius="6"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Content="Install"
                                                Padding="14,4" Cursor="Hand"
                                                Foreground="{DynamicResource LinkForeground}"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource LinkForeground}"
                                                BorderThickness="1"
                                                Command="{Binding InstallCommand}"
                                                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Remove"
                                                Padding="14,4" Cursor="Hand"
                                                Foreground="{DynamicResource ErrorText}"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource ErrorText}"
                                                BorderThickness="1"
                                                Command="{Binding UninstallCommand}"
                                                Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVisibility}}"/>
                                        <ProgressBar Width="120" Height="6"
                                                     Minimum="0" Maximum="1"
                                                     Value="{Binding Progress}"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>

                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontFamily="{Binding WpfFamily}"
                                                       FontSize="16" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                            <Border Margin="8,0,0,0" Padding="6,1"
                                                    Background="{DynamicResource PanelBorder}"
                                                    CornerRadius="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiary}"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding LicenseLabel}" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding LicenseLabel, Converter={StaticResource NullToVisibility}}"/>
                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="11"
                                                   Foreground="{DynamicResource ErrorText}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
